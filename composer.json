{
    "name": "nadimtuhin/dse-scrapper",
    "description": "Dhaka Stock Exchange Scrapper",
    "keywords": ["dse"],
    "homepage": "http://nadimtuhin.github.io",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Nadim Tuhin",
            "email": "nadimtuhin@gmail.com",
            "homepage": "http://nadimtuhin.github.io",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=7.4",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6 || ^10.5 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "NadimTuhin\\DSE\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NadimTuhin\\DSE\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "extra": {
        "branch-alias": {
            "dev-master": "0.1-dev"
        }
    }
}